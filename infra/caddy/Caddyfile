{$DOMAIN_NAME} {
    encode gzip

    request_body {
        max_size 20MB
    }

    # Django static
    handle_path /static/* {
        root * /var/www/static
        file_server
    }

    # Django media
    handle_path /media/* {
        root * /var/www/media
        file_server
    }

    # NextAuth → frontend (важно: до /api/*)
    handle /api/auth/* {
        reverse_proxy frontend:3000
    }

    # Django API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Django admin
    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Next.js (всё остальное)
    handle {
        reverse_proxy frontend:3000
    }

    handle_errors {
        @413 expression {http.error.status_code} == 413
        handle @413 {
            header Content-Type "application/json"
            respond `{"error":"payload_too_large","message":"Файл превышает лимит 20 МБ.","status":413}` 413
        }
        @5xx expression {http.error.status_code} >= 500
        handle @5xx {
            header Content-Type "application/json"
            respond `{"error":"server_error","message":"Внутренняя ошибка сервера.","status":{http.error.status_code}}` {http.error.status_code}
        }
    }
}
