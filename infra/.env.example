# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,backend
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gmail.com
DJANGO_SUPERUSER_PASSWORD=admin123

# PostgreSQL
POSTGRES_DB=foody
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Worker task frequency Format: '10s' - 10 секунд, '1m' - 1 минута, '1h' - 1 час
UPDATE_STATS_INTERVAL=1m

# Frontend / Next.js
NEXT_PUBLIC_API_URL=http://localhost/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1
AUTH_SECRET=generate_random_long_string_here
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost

# Nginx
DOMAIN_NAME=localhost
